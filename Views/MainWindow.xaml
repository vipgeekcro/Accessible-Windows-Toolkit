<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Accessible Windows Toolkit" Width="980" Height="740" MinWidth="720" MinHeight="520" FontFamily="Segoe UI" FontSize="15" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Window.Resources>
        <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="16,9" /><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="140" /></Style>
        <Style x:Key="StrongCheckBoxFocus" TargetType="Control">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderThickness="3" CornerRadius="2" Margin="-4"><AdornedElementPlaceholder /></Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="FocusVisualStyle" Value="{StaticResource StrongCheckBoxFocus}" />
        </Style>
      </Window.Resources>
      <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Select the applications and components you want to remove:" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" TextWrapping="Wrap" />
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="Gray" Padding="10">
          <ScrollViewer Name="CandidateScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Name="CandidatePanel" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Name="SelectAllButton" Content="Select All" Margin="0,0,10,0" AutomationProperties.Name="Select All" AutomationProperties.AcceleratorKey="Alt+A" />
          <Button Grid.Column="1" Name="DeselectAllButton" Content="Deselect All" AutomationProperties.Name="Deselect All" AutomationProperties.AcceleratorKey="Alt+U" />
          <Button Grid.Column="3" Name="DebloatButton" Content="Debloat" MinWidth="165" FontWeight="SemiBold" AutomationProperties.Name="Debloat" AutomationProperties.AcceleratorKey="Alt+D" />
        </Grid>
      </Grid>
    </Window>
