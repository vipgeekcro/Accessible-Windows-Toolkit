<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Title="Accessible Windows Toolkit" Width="650" Height="430" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="15" SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Window.Resources><Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="16,9" /><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="140" /></Style></Window.Resources>
      <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Confirm removal" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock Name="ConfirmText" FontSize="16" TextWrapping="Wrap" Focusable="False" /></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Name="YesButton" Content="Yes" AutomationProperties.Name="Yes" AutomationProperties.AcceleratorKey="Alt+Y" Margin="0,0,10,0" />
          <Button Name="NoButton" Content="No" AutomationProperties.Name="No" AutomationProperties.AcceleratorKey="Alt+N" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Window>
