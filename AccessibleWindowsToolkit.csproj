<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AccessibleWindowsToolkit</AssemblyName>
    <RootNamespace>AccessibleWindowsToolkit</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>Accessible Windows Toolkit</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- The UI definitions are embedded in the assembly as resources. They are
         intentionally loaded at runtime because they are x:Class-free reference
         windows, but no external Views folder is required beside the EXE. -->
    <Page Remove="Views\*.xaml" />
    <Resource Include="Views\*.xaml" />
  </ItemGroup>
</Project>
